# syntax=docker/dockerfile:1
#
# cronstable — Fedora variant. Tracks a recent Fedora release and its
# leading-edge Python (3.14 on Fedora 44). For users who run Fedora hosts or
# want a more current RPM userland than the enterprise UBI base.
#
# Build locally:
#   docker build -f docker/Dockerfile.fedora -t cronstable:fedora .
# CI passes the released version via --build-arg VERSION=X.Y.Z; a plain build
# reads it from .git (kept in the context by .dockerignore).

ARG FEDORA_VERSION=44

# ---- build stage --------------------------------------------------------
FROM fedora:${FEDORA_VERSION} AS builder

WORKDIR /src

# Layer contract, load-bearing for CI speed: everything from here through the
# orjson step reads nothing from the source tree except pyproject.toml and
# the docker/ helper scripts (extract_deps.py, install_orjson.sh) and never
# references the per-commit VERSION arg, so
# buildx's GHA cache reuses these expensive layers (toolchain plus every
# dependency, source-compiled under QEMU on the wheel-less arches) across
# source-only commits; a typical push rebuilds only the cheap project
# install at the bottom of this stage.
# CI sets DEPS_REFRESH to the run id on a RELEASE so a release re-resolves
# every dependency fresh; ordinary pushes leave it "" and ride the cache.
ARG DEPS_REFRESH=""

# Install Fedora's system Python plus a toolchain so pip can source-compile any
# dep lacking a wheel for the target arch. The toolchain stays in this builder
# stage. git is now installed unconditionally: a plain local build needs it for
# setuptools_scm to read .git, and gating it on VERSION (as this layer once
# did) would put the per-commit version into the cache key and rebuild the
# toolchain on every push.
# retry() re-runs a network step (package install, pip download) a few times
# with backoff, so a transient mirror/index hiccup does not fail the build.
RUN set -eux; \
    : "deps-refresh=${DEPS_REFRESH}"; \
    retry() { n=0; until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then return 1; fi; echo "retry $n: $*"; sleep $((n*5)); done; }; \
    retry dnf --setopt=retries=10 install -y python3 python3-pip python3-devel gcc make libffi-devel libsodium-devel git; \
    dnf clean all

# Only pyproject.toml and the shared extraction helper reach the dependency
# layer: its cache key is the dependency metadata plus the small script that
# reads it, never the rest of the tree.
COPY pyproject.toml /tmp/deps/pyproject.toml
COPY docker/extract_deps.py /tmp/deps/extract_deps.py

# Install the third-party dependencies into the venv the runtime stage will
# copy. The requirement strings are read out of pyproject.toml by the COPYd
# extract_deps.py helper (core dependencies plus the push-pq and discovery
# extras), the exact strings `pip install ".[push-pq,discovery]"` would
# resolve, so the two can never drift and a renamed extra fails the build
# loudly (KeyError). The build backend (build-system.requires) goes into a
# throwaway venv, /tmp/deps/buildenv: the project install below uses it to
# build the wheel without network access, and it never pollutes the shipped
# /opt/venv.
#
# libsodium-devel + SODIUM_INSTALL=system: on the archs with no PyNaCl wheel
# (ppc64le/s390x) pip builds PyNaCl from its sdist, and with SODIUM_INSTALL
# unset that build compiles the BUNDLED libsodium and runs its whole autotools
# test suite under QEMU emulation (tens of minutes per arch), and the suite
# itself is what failed the 1.2.31 release (kdf_hkdf reported a harness-level
# ERROR under this base's GCC 15 toolchain, on s390x and ppc64le, so `make
# check` exited non-zero and the wheel build died on every retry).
# SODIUM_INSTALL=system makes PyNaCl skip the bundled build entirely and link
# Fedora's own libsodium (1.0.22, comfortably past PyNaCl 1.6.x's 1.0.19
# floor), which the distro compiled and tested on real hardware. The sealed-
# box self-test below still proves the pairing works under emulation. On
# amd64/arm64 PyNaCl installs as a wheel and the variable is inert.
RUN set -eux; \
    retry() { n=0; until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then return 1; fi; echo "retry $n: $*"; sleep $((n*5)); done; }; \
    export SODIUM_INSTALL=system; \
    python3 -m venv /opt/venv; \
    retry /opt/venv/bin/pip install --no-cache-dir --upgrade pip; \
    /opt/venv/bin/python /tmp/deps/extract_deps.py /tmp/deps/pyproject.toml; \
    retry /opt/venv/bin/pip install --no-cache-dir --timeout 60 -r /tmp/deps/requirements.txt; \
    python3 -m venv /tmp/deps/buildenv; \
    retry /tmp/deps/buildenv/bin/pip install --no-cache-dir --timeout 60 -r /tmp/deps/build-requires.txt

# The push-pq (PyNaCl + cryptography) and discovery (zeroconf) extras above
# are part of the image contract: a `push:` or `web.bonjour` section fails closed at config
# load, so an image missing them would crash-loop with no in-image
# remediation (pip is stripped from the runtime stage below). PyNaCl has
# wheels on amd64/arm64 and source-builds against the system libsodium on
# ppc64le/s390x (see SODIUM_INSTALL above). Verify with a real sealed-box
# round-trip plus a zeroconf import; a failure fails the build. cryptography carries the post-quantum `xwing` suite behind
# an environment marker, so it is checked only where it resolved, and by its
# HPKE module rather than by sealing: these images take a PyPI wheel with its
# own OpenSSL, so a too-old release is the failure worth catching.
RUN /opt/venv/bin/python -c 'from nacl.public import PrivateKey, SealedBox; k = PrivateKey.generate(); m = b"cronstable push self-test"; assert SealedBox(k).decrypt(SealedBox(k.public_key).encrypt(m)) == m; import importlib.util as u; assert u.find_spec("cryptography") is None or u.find_spec("cryptography.hazmat.primitives.hpke") is not None, "cryptography is too old to seal xwing"; import zeroconf, zeroconf.asyncio; print("push-pq and discovery extras verified")'

# Best-effort orjson (the `speedups` extra) for the durable-state / cluster
# JSON paths; docker/install_orjson.sh never fails the build and never ships
# a broken orjson (cronstable/_json falls back to stdlib json when it is
# absent). amd64/arm64 install a wheel; the other published arches
# (ppc64le/s390x) have none, so RUST_SETUP installs Fedora's own rust +
# cargo (new enough here, no rustup needed) for the source build. The script
# is COPYd here, below the dependency layers, so editing it never
# invalidates their cache.
COPY docker/install_orjson.sh /tmp/deps/install_orjson.sh
RUN set -eux; \
    RUST_SETUP="dnf --setopt=retries=10 install -y rust cargo" \
    sh /tmp/deps/install_orjson.sh "orjson>=3.11.6"; \
    dnf clean all

# ---- project install: the only per-commit layers ------------------------

# In CI we pass the already-computed release version so the build is
# deterministic and needs no git history. A plain local build leaves it empty
# and setuptools_scm reads the version from .git (kept in the context by
# .dockerignore; the toolchain layer's git binary serves).
ARG VERSION=""

COPY . .

# Build the wheel with the cached buildenv's backend (--no-build-isolation:
# no per-commit network fetch of setuptools/setuptools_scm) and install it
# with --no-deps: every dependency is already in /opt/venv from the cached
# layer above, and adding one edits pyproject.toml, which rebuilds that
# layer. `pip check` then proves the split left nothing unsatisfied.
RUN set -eux; \
    if [ -n "$VERSION" ]; then export SETUPTOOLS_SCM_PRETEND_VERSION="$VERSION"; fi; \
    /tmp/deps/buildenv/bin/pip wheel --no-deps --no-build-isolation --wheel-dir /tmp/deps/wheelhouse .; \
    /opt/venv/bin/pip install --no-cache-dir --no-deps /tmp/deps/wheelhouse/cronstable-*.whl; \
    /opt/venv/bin/pip check

# Drop pip from the venv before it ships. The runtime image installs nothing
# (no package manager, read-only root filesystem), so pip and its vendored
# bundle are pure dead weight in the copied /opt/venv. Nothing at runtime
# imports pip, so removing it is safe; setuptools stays for any dependency that
# still reaches for pkg_resources.
RUN /opt/venv/bin/pip uninstall -y pip || true

# ---- runtime stage ------------------------------------------------------
FROM fedora:${FEDORA_VERSION}

LABEL org.opencontainers.image.title="cronstable" \
      org.opencontainers.image.description="A modern, rootless-container-friendly cron replacement (Fedora)." \
      org.opencontainers.image.source="https://github.com/ptweezy/cronstable" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# The venv references the system interpreter at /usr/bin/python3; both stages
# are fedora:${FEDORA_VERSION}, so it is present and the version matches.
# libsodium: the runtime half of the builder's SODIUM_INSTALL=system pairing.
# On ppc64le/s390x PyNaCl's extension links the system library instead of a
# bundled copy, so the shared object must exist here too; on amd64/arm64 the
# wheel carries its own and the package is a few hundred idle kilobytes.
RUN set -eux; \
    retry() { n=0; until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then return 1; fi; echo "retry $n: $*"; sleep $((n*5)); done; }; \
    retry dnf --setopt=retries=10 install -y python3 libsodium; \
    dnf clean all

COPY --from=builder /opt/venv /opt/venv

# Run as an unprivileged, non-root user (65534 = "nobody").
USER 65534:65534

ENTRYPOINT ["cronstable"]
CMD ["-c", "/etc/cronstable.d"]
