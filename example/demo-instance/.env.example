# Copy to .env beside this file (.env is gitignored) and fill in.
#
#   cp example/demo-instance/.env.example example/demo-instance/.env

# From the Cloudflare Zero Trust dashboard when you create the tunnel:
# Networks -> Tunnels -> Create a tunnel -> Docker -> copy the token out
# of the shown `cloudflared ... run <TOKEN>` command.  Treat it as a
# secret: it authorizes publishing traffic through your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. The demo's view-scoped bearer token is public by design (it
# ships inside the companion app); set this only to rotate it, and update
# the app to match. The gateway gives anonymous visitors the same bounded
# actions without it.
#CRONSTABLE_DEMO_VIEW_TOKEN=cronstable-public-demo-view

# Required. The gateway and demo-operator's private control+approve token,
# used on the internal daemon API for sample actions and housekeeping. There is
# deliberately no default: this one is a real control token, so generate a
# fresh value per host and keep it out of git.
#
#   printf 'CRONSTABLE_DEMO_OPERATOR_TOKEN=%s\n' \
#     "$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')" >> .env
CRONSTABLE_DEMO_OPERATOR_TOKEN=

# Optional public hostname; must match the tunnel mapping and gateway Origin gate.
#CRONSTABLE_DEMO_HOSTNAME=demo.cronstable.com
