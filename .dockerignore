# Keep the build context small. .git, README.md and LICENSE MUST stay:
# setuptools_scm reads the git tags, and pyproject.toml references the other
# two at build time (tests/test_dockerfile_layering.py pins this file).
.venv
.venv314
.tox
.mypy_cache
.ruff_cache
.pytest_cache
.pip-cache
.pq-cache
release-inputs
dist
build
*.egg-info
__pycache__
*.pyc

# Not needed to build the package. Keep pyinstaller/: its Makefile uses the
# repo root as the build context, so this file governs that build too.
.claude
.github
docker
# except the shared helpers every Dockerfile COPYs. Each negation must
# follow the exclusion it carves out.
!docker/extract_deps.py
!docker/install_orjson.sh
!docker/python_runtime.py
# and the post-quantum wheelhouse the release workflow fills per libc; on a
# local build the directories hold only their .gitkeep placeholders.
!docker/wheelhouse
example
scripts
target
tests
acceptance
acceptance-results
.editorconfig
.gitignore

# Docs, website assets and side trees reach neither the wheel nor any image
# build. docs/ alone is about 45 MB; sending it would make every screenshot
# edit invalidate the COPY layer, and everything below it, in every platform
# build.
docs
wiki
benchmarks
packaging
HISTORY.md
coverage.xml
