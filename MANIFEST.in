include LICENSE

# setuptools_scm seeds the sdist with every tracked file, so a note left at
# the repo root would ship to PyPI. Deny root-level markdown and add back the
# published documents; tests/test_packaging.py pins both.
exclude *.md
include README.md
include HISTORY.md
include CONTRIBUTING.md
include LICENSING.md
include SECURITY.md
include TRADEMARKS.md

recursive-include tests *
recursive-include .github/tests *.py *.ini
recursive-include acceptance *.py *.ini *.txt *.md *.sh *.cmd
recursive-include example *
include scripts/generate_build_files.py
include docker/images.toml
recursive-include docker/templates *
recursive-include pyinstaller/requirements *.txt
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude env *

# Drop the website images; add back the files the shipped tests read
# (tests/test_packaging.py checks this list).
prune docs
include docs/openapi.yaml
include docs/demo/index.html
include docs/demo/_backend.html
include docs/logo-engine.js
include docs/logo-lab.html
include docs/comparison.html
include docs/palette.css
include docs/relay-protocol.md

# wiki/ and benchmarks/ stay (about 1.2 MB): tests/test_tui.py reads
# wiki/Web-Dashboard.md and tests/test_benchmarks.py runs benchmarks/.

# The shipped suite also reads Dockerfile, docker/, .dockerignore,
# .github/docker-matrix.json and .github/workflows/release.yml; keep them
# unpruned (tests/test_dockerfile_layering.py, tests/test_ci_fences.py).
